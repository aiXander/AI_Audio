#!/usr/bin/env bash
# SA3 Studio: dark skin over upstream's MLX gradio UI, localhost only.
#   sa3lab/studio                 # medium + same-l, 120 s, on http://127.0.0.1:7860
#   sa3lab/studio --dit sm-music  # any upstream sa3_gradio.py flag passes through
#   sa3lab/studio --watch         # opt-in: auto-restart on every code change (devwatch.py)
set -e
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Every SA3 download lands in AI_Audio/models/ (one folder to delete to reclaim disk).
export HF_HUB_CACHE="${HF_HUB_CACHE:-$HERE/../models/hf-cache}"
PY="$HERE/../stable-audio-3/optimized/mlx/.venv/bin/python"
# Default: the server runs directly, so code edits (often agents') do NOT restart it and
# reload the page mid-session; they go live on the next `make start`. --watch runs it
# under devwatch.py, which restarts on every sa3lab code change once no render is running.
WATCH=; args=()
for a in "$@"; do
  case "$a" in --watch) WATCH=1 ;; --no-watch) ;; *) args+=("$a") ;; esac
done
if [ -n "$WATCH" ]; then exec "$PY" "$HERE/devwatch.py" "${args[@]}"; fi
exec "$PY" "$HERE/studio.py" "${args[@]}"
