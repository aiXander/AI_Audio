#!/usr/bin/env bash
# SA3 Studio: dark skin over upstream's MLX gradio UI, localhost only.
#   sa3lab/studio                 # medium + same-l, 120 s, on http://127.0.0.1:7860
#   sa3lab/studio --dit sm-music  # any upstream sa3_gradio.py flag passes through
#   sa3lab/studio --no-watch      # no auto-restart on code changes (devwatch.py)
set -e
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Every SA3 download lands in AI_Audio/models/ (one folder to delete to reclaim disk).
export HF_HUB_CACHE="${HF_HUB_CACHE:-$HERE/../models/hf-cache}"
PY="$HERE/../stable-audio-3/optimized/mlx/.venv/bin/python"
# Default: devwatch.py restarts the server whenever sa3lab code changes (the page
# reloads itself). --no-watch runs the server directly.
for a in "$@"; do [ "$a" = "--no-watch" ] && NOWATCH=1; done
if [ -n "$NOWATCH" ]; then
  args=(); for a in "$@"; do [ "$a" != "--no-watch" ] && args+=("$a"); done
  exec "$PY" "$HERE/studio.py" "${args[@]}"
fi
exec "$PY" "$HERE/devwatch.py" "$@"
